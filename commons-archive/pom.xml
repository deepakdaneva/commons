<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.deepakdaneva</groupId>
        <artifactId>commons</artifactId>
        <version>1.1.2-SNAPSHOT</version>
    </parent>

    <groupId>io.github.deepakdaneva.commons</groupId>
    <artifactId>commons-archive</artifactId>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Utilities for detecting and reading compressed and archived content (zip, tar, 7z, gzip, bzip2, xz and
        more) on top of Apache Commons Compress.
    </description>

    <dependencies>
        <!--
            Provided scope: the consuming application chooses (and upgrades) its own Commons Compress / Commons IO
            versions. They are not pulled in transitively, so consumers must declare them explicitly.
        -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <!-- Commons Compress needs xz on the class path to decode any 7z entry; consumers reading 7z must add it too. -->
        <dependency>
            <groupId>org.tukaani</groupId>
            <artifactId>xz</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
            <!-- Ship the license and notice inside the jar. -->
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>NOTICE</include>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
    </build>
</project>
